# Copy to backend/.env and adjust for your machine.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=maison_lumiere
DB_USER=root
DB_PASS=

# Origin of the React dev server (used for CORS)
CORS_ORIGIN=http://localhost:5173
APP_ENV=development

# Key used to sign in to /admin. Set your own before deploying.
ADMIN_KEY=change-me
